# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# AGENTS.md is NOT in that auto-ignored list, and without this rule it deploys
# as a public page at /AGENTS — internal content boundaries and all. Verified
# on a preview build. Do not remove.
AGENTS.md

# Draft content
drafts/
*.draft.mdx

# Screenshot workflow — see images/CAPTURE-LIST.md
images/CAPTURE-LIST.md

# Work-in-progress captures. Anything not yet reviewed for client data goes
# here or carries a .wip suffix, so it cannot reach a public deploy by accident.
images/_wip/
*.wip.png
*.wip.jpg
