          {
            "group": "Intelligence",
            "pages": [
              "agency-wiki/kenny",
              "agency-wiki/brand-brain"
            ]
          },
          {
            "group": "Agency operations",
            "pages": [
              "agency-wiki/skills",
              "agency-wiki/automations",
              "agency-wiki/integrations",
              "agency-wiki/credits"
            ]
          }
        ]
      },
      {
        "tab": "Brands wiki",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "brands-wiki/overview",
              "brands-wiki/brand-guide"
            ]
          },
          {
            "group": "Onboarding",
            "pages": [
              "brands-wiki/onboarding/overview",
              "brands-wiki/onboarding/brand-details",
              "brands-wiki/onboarding/products-and-assets",
              "brands-wiki/onboarding/connect-meta",
              "brands-wiki/onboarding/launch-checklist"
