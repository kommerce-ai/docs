  "redirects": [
    {
      "source": "/agency-wiki",
      "destination": "/agency-wiki/overview"
    },
    {
      "source": "/brands-wiki",
      "destination": "/brands-wiki/overview"
    },
    {
      "source": "/agency-wiki/onboard-a-brand",
      "destination": "/agency-wiki/onboarding/add-a-brand"
    },
    {
      "source": "/agency-wiki/creative-production",
      "destination": "/agency-wiki/creative/overview"
    },
    {
      "source": "/brands-wiki/creative-production",
      "destination": "/brands-wiki/creative/overview"
    },
    {
      "source": "/product/agency/onboard-a-brand",
      "destination": "/agency-wiki/onboarding/add-a-brand"
    },
    {
      "source": "/product/agency/:slug*",
      "destination": "/agency-wiki/:slug*"
    },
    {
      "source": "/product/brand/:slug*",
      "destination": "/brands-wiki/:slug*"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
