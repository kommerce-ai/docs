{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kommerce",
  "description": "Documentation for Kommerce — your AI brand department, installed in a week.",
  "colors": {
    "primary": "#00071A",
    "light": "#EAFF5E",
    "dark": "#00071A"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
