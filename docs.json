            "pages": [
              "agency-wiki/onboarding/overview",
              "agency-wiki/onboarding/add-a-brand",
              "agency-wiki/onboarding/meta-access",
              "agency-wiki/onboarding/launch-readiness"
            ]
          },
          {
            "group": "The five jobs",
            "pages": [
              "agency-wiki/angle-research",
              {
                "group": "Creative production",
                "pages": [
                  "agency-wiki/creative/overview",
                  "agency-wiki/creative/image-generation",
                  "agency-wiki/creative/video-generation"
                ]
              },
              "agency-wiki/meta-audit",
              "agency-wiki/media-buying",
              "agency-wiki/reporting"
            ]
